{
  "schema_version": 1,
  "version": "wartime-borders-v1",
  "kingdoms": [
    "벨로아",
    "드라켄",
    "루메린"
  ],
  "map_geometry_status": "political borders not finalized; checkpoints are conceptual route nodes anchored to regions, not exact coordinates",
  "reputation": {
    "scope": "per_kingdom",
    "min": -100,
    "max": 100,
    "default_home": 10,
    "default_foreign": 0,
    "bands": [
      {
        "min": -100,
        "max": -61,
        "label": "국가 수배",
        "access": "arrest_if_identified"
      },
      {
        "min": -60,
        "max": -21,
        "label": "적대 인물",
        "access": "entry_denied"
      },
      {
        "min": -20,
        "max": 19,
        "label": "무명 외국인",
        "access": "screening_and_sponsor"
      },
      {
        "min": 20,
        "max": 49,
        "label": "알려진 협력자",
        "access": "conditional_pass"
      },
      {
        "min": 50,
        "max": 79,
        "label": "공로자",
        "access": "priority_pass"
      },
      {
        "min": 80,
        "max": 100,
        "label": "국빈급 인사",
        "access": "special_diplomatic_access"
      }
    ],
    "changes": "GM decides reputation on verified quests, war service, rescue, crime and witnessed reputation; no automatic reputation farming by small talk",
    "not_affection": "Separate from NPC affection: approval or disapproval by government and society, not personal friendship."
  },
  "entry_rules": {
    "home_reentry": "identity check unless wanted or military lockdown",
    "foreign_entry": {
      "reputation_below_minus20": "denied; wanted status may lead to arrest",
      "reputation_minus20_to19": "permit plus vetted purpose and local sponsor or strong commercial writ; scrutiny",
      "reputation_20_to49": "permit and ordinary security screening",
      "reputation_50_to79": "permit streamlined but war closures may stop entry",
      "reputation_80_plus": "special escort or diplomatic access; sovereign military zones still restricted"
    },
    "npc_affection_override": "affection 50+ with registered influential local sponsor may substitute sponsor requirement, not override criminal wanted status or closure",
    "permit": {
      "issued_by": "destination kingdom border office, diplomatic mission, licensed trader or authorized military command",
      "types": [
        "visitor",
        "merchant",
        "guild_contract",
        "diplomatic",
        "military_safe_conduct"
      ],
      "temporary": true,
      "expires": true,
      "may_be_revoked": true
    },
    "security_check": [
      "passport_or_identity",
      "origin_kingdom",
      "reputation",
      "permit",
      "purpose",
      "escort_or_sponsor",
      "war_alert",
      "contraband",
      "military_service"
    ],
    "no_guaranteed_success": "Reputation alone never forces border opening."
  },
  "checkpoints": [
    {
      "id": "BORDER-WE-01",
      "name": "회색 협곡 서동 검문관",
      "kingdoms": [
        "벨로아",
        "드라켄"
      ],
      "region_anchors": [
        "W4",
        "E3"
      ],
      "state": "heavily_contested",
      "route_type": "fortified_pass"
    },
    {
      "id": "BORDER-WS-01",
      "name": "서남 상단 관문",
      "kingdoms": [
        "벨로아",
        "루메린"
      ],
      "region_anchors": [
        "W5",
        "S2"
      ],
      "state": "regulated_trade",
      "route_type": "merchant_road"
    },
    {
      "id": "BORDER-ES-01",
      "name": "동남 교량 검문소",
      "kingdoms": [
        "드라켄",
