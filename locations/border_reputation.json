        "E4",
        "S2"
      ],
      "state": "restricted_transit",
      "route_type": "bridge_and_caravan"
    }
  ],
  "actions": [
    {
      "id": "domestic_travel",
      "label": "자국 이동",
      "min_rep": -60,
      "need": [
        "not_wanted",
        "local_access"
      ]
    },
    {
      "id": "border_request",
      "label": "국경 통행 신청",
      "min_rep": -20,
      "need": [
        "entry_writ_or_sponsor",
        "checkpoint_open"
      ]
    },
    {
      "id": "foreign_trade",
      "label": "타국 일반 거래",
      "min_rep": 0,
      "need": [
        "legal_entry",
        "merchant_permission_if_needed"
      ]
    },
    {
      "id": "foreign_guild_quest",
      "label": "타국 길드 의뢰",
      "min_rep": 20,
      "need": [
        "legal_entry",
        "guild_recognition"
      ]
    },
    {
      "id": "border_escort",
      "label": "전시 호송 허가",
      "min_rep": 30,
      "need": [
        "military_or_guild_contract",
        "route_open"
      ]
    },
    {
      "id": "foreign_spellbook",
      "label": "드라켄 마법서 거래",
      "min_rep": 20,
      "need": [
        "legal_entry",
        "arcane_registration_or_school_permission"
      ]
    },
    {
      "id": "foreign_noble_audience",
      "label": "타국 영주 접견 신청",
      "min_rep": 50,
      "need": [
        "invitation",
        "court_approval"
      ]
    },
    {
      "id": "restricted_archive",
      "label": "고위 국가기관 출입",
      "min_rep": 80,
      "need": [
        "explicit_official_permit",
        "institution_access"
      ]
    },
    {
      "id": "military_zone",
      "label": "군사 통제구역 출입",
      "min_rep": 80,
      "need": [
        "mission_specific_command_authorization"
      ]
    }
  ],
  "events": [
    {
      "id": "inspection",
      "label": "검문",
      "when": "border_crossing",
      "outcomes": [
        "pass",
        "secondary_screening",
        "delay",
        "denied",
        "arrest_if_warrant"
      ]
    },
    {
      "id": "lockdown",
      "label": "전선 폐쇄",
      "when": "war_escalation",
      "outcomes": [
        "route_closed",
        "detour",
        "humanitarian_corridor_exception"
      ]
    },
    {
      "id": "smuggling",
      "label": "밀입국 시도",
      "when": "player_choice",
      "outcomes": [
        "escape",
        "detected",
        "confiscation",
        "pursuit",
        "wanted_flag"
      ]
    }
  ],
  "save_fields": [
    "kingdom_reputation",
    "national_origin",
    "entry_permits",
    "wanted_flags",
    "border_crossing_history",
    "active_border_route"
  ],
  "rules": [
    "A player's origin kingdom is selected in character creation; other country reputations start at 0.",
    "Personal NPC affection and kingdom reputation are distinct values.",
    "Never assign exact checkpoint x/y or national border polygons until geography art is approved.",
    "Each border crossing depends on war conditions and NPC responses; no automatic immunity.",
    "Entry restriction never forces one deterministic outcome; legal travel, detours and risk routes remain possibilities."
  ]
}
